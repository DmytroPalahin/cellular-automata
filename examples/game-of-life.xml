<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conway's Game of Life, as described in section 1.2 of the subject:
    - a dead cell comes alive if exactly three of its eight neighbors are alive;
    - a live cell stays alive if two or three of its eight neighbors are alive.
  G8* is the 8-neighborhood without the cell itself.
-->
<automaton name="Game of Life">
    <description>Conway's Game of Life (B3/S23) on a random soup where 15% of the cells start alive.</description>
    <dimension>2</dimension>
    <size>64, 96</size>
    <rule>
        SI(EQ(COMPTER(G0), 1),
        OU(EQ(COMPTER(G8*), 2), EQ(COMPTER(G8*), 3)),
        EQ(COMPTER(G8*), 3))
    </rule>
    <initial>RANDOM(15)</initial>
</automaton>